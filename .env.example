# Different strong passwords for administration and application.
# Never expose DATABASE_ADMIN_URL in the web process.
DATABASE_ADMIN_URL=postgresql://fomento:troque_senha_admin@localhost:5432/fomento
DATABASE_URL=postgresql://fomento_app:troque_senha_app@localhost:5432/fomento
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_ADMIN_FORTE
POSTGRES_APP_PASSWORD=SUBSTITUA_POR_SENHA_APP_FORTE_DISTINTA_COM_24_OU_MAIS
APP_DB_PASSWORD=SUBSTITUA_POR_SENHA_APP_FORTE_DISTINTA_COM_24_OU_MAIS
SESSION_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES_OU_MAIS
# Chave de 32 bytes em base64; gere: openssl rand -base64 32 (preserve em cofre separado)
MFA_ENCRYPTION_KEY=GERAR_32_BYTES_ALEATORIOS_EM_BASE64
BACKUP_ENCRYPTION_KEY=GERAR_OUTRA_CHAVE_ALEATORIA_DE_32_BYTES_EM_BASE64
APP_ORIGIN=http://localhost:3000
# Habilitar apenas atrás de Nginx controlado que substitua X-Real-IP
TRUST_PROXY_IP=false
NEXT_PUBLIC_APP_NAME=AXE Fomento

# Importação oficial exige revisão de contrato da API e licença. Desabilitada por padrão.
ENABLE_OFFICIAL_SOURCE_SYNC=no

# AF-018: anexos em desenvolvimento; desabilitados até revisão de antivírus e infraestrutura.
ENABLE_DOCUMENT_UPLOADS=no
ATTACHMENT_ENCRYPTION_KEY=GERAR_OUTRA_CHAVE_DE_32_BYTES_EM_BASE64

# AF-022: registro manual e privado de protocolos; desligado até homologação.
ENABLE_EXTERNAL_PROTOCOL_RECORDS=no

# AF-023: diligências internas vinculadas a protocolos (desligado até homologação).
ENABLE_DILIGENCE_RECORDS=no

# AF-024: acompanhamento financeiro declarado (sem integração bancária).
ENABLE_FINANCIAL_TRACKING=no

# AF-025: planejamento físico-financeiro declarado. Desabilitar até homologação.
ENABLE_PROJECT_BUDGET=no

# AF-028: fontes normativas declaradas; escrita desabilitada até aceite jurídico.
ENABLE_NORMATIVE_REGISTRY=no

# AF-029: mapa preliminar de enquadramento, sem decisão jurídica automática.
ENABLE_MODALITY_MAP=no

# AF-030: sugestões a partir de TEXTO fornecido por pessoa, sem OCR ou IA generativa.
# Ativar apenas após homologação de segurança e validação jurídica operacional.
ENABLE_EDICT_ASSISTED_EXTRACTION=no

# AF-031: busca por intenção com dicionário controlado e PostgreSQL FTS.
# Sem embeddings, sem IA externa, sem certificar disponibilidade ou elegibilidade.
ENABLE_SEMANTIC_CATALOG=no

# AF-032: geração por modelo local e revisão humana, sem IA generativa.
ENABLE_PROPOSAL_DRAFTS=no

# AF-033: decisões humanas editoriais em versões exatas, sem efeito jurídico.
ENABLE_PROPOSAL_CONTENT_REVIEWS=no

# AF-034: diretório municipal declaratório de fontes nacionais.
# Não comprova disponibilidade de recursos, habilitação ou condições de crédito.
ENABLE_FINANCIER_DIRECTORY=no

# AF-035: referências BNDES Cidades + registros de conferência humana.
# Sem disponibilidade de crédito em tempo real ou aprovação jurídica.
ENABLE_BNDES_CITY_CATALOG=no

# AF-036: fontes oficiais COFIEX/PFE e conferências internas por projeto.
# Não envia pleitos, nem avalia financiamento ou confere vigência automaticamente.
ENABLE_COFIEX_CATALOG=no
