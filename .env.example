# Use senhas aleatórias e diferentes. .env nunca deve ser versionado.
POSTGRES_PASSWORD=DEFINIR_UMA_SENHA_FORTE_ADMIN
APP_DB_PASSWORD=DEFINIR_OUTRA_SENHA_FORTE_RUNTIME_24_CARACTERES
SESSION_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES_OU_MAIS
NEXT_PUBLIC_APP_NAME=Axes Fomento

# Para `npm run dev` sem Docker (não inclua DATABASE_URL neste arquivo):
PGHOST=localhost
PGPORT=5432
PGDATABASE=fomento
PGUSER=fomento_app
PGPASSWORD=DEFINIR_OUTRA_SENHA_FORTE_RUNTIME_24_CARACTERES
