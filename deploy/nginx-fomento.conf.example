# EXEMPLO: substitua o domínio e certificados antes de habilitar.
# Apenas Nginx deve aceitar conexões públicas. O container web escuta em 127.0.0.1:3000.
server {
    listen 80;
    server_name fomento.example.gov.br;
    return 301 https://fomento.example.gov.br$request_uri;
}
server {
    listen 443 ssl;
    server_name fomento.example.gov.br;
    ssl_certificate /etc/letsencrypt/live/fomento.example.gov.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fomento.example.gov.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host fomento.example.gov.br;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }
}
